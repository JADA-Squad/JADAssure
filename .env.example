# Copy to .env and fill in. Never commit .env (GR-15).

# --- Database (used by docker compose) ---
POSTGRES_USER=jadassure
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=jadassure
# Host port for Postgres; 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# --- Auth (decision 0001 D-5) ---
# Required. The API refuses to start while this is unset or still "change-me".
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=480
# Allow self-service organization signup (FR-01). Turn off for shared environments.
ALLOW_SIGNUP=true

# --- Worker ---
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_STALE_SECONDS=30

# --- AI provider (decision 0001 D-2; off by default per org, GR-08) ---
# Leave empty to make the external provider unavailable to every org.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

LOG_LEVEL=INFO
